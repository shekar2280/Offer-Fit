{
  "manifest_version": 3,
  "name": "Hiring Intelligence Sync",
  "version": "1.0",
  "description": "Instantly sync job descriptions to your Resume Analyzer.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/jobs/*", "*://*.indeed.com/*", "*://*.glassdoor.com/*"],
      "js": ["content.js"]
    }
  ]
}
