{
  "manifest_version": 3,
  "name": "Hiring Data Sync",
  "version": "1.0",
  "description": "Premium AI-powered job extraction for 100+ platforms.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://offerfit-backend.onrender.com/*",
    "https://offerfit.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scraper.js", "content.js"]
    }
  ]
}
