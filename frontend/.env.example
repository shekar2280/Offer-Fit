# Existing application services
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BACKEND_URL=
BACKEND_API_KEY=
GEMINI_API_KEY=

# Job hub. Use the exact HTTPS origin in production; no trailing path.
OFFERFIT_APP_URL=https://offerfit.vercel.app
# Generate a private 32-byte key encoded as base64. Never use a NEXT_PUBLIC_ name.
OFFERFIT_ENCRYPTION_KEY=
OFFERFIT_GEMINI_MODEL=gemini-3.8-flash

# Add /api/hub/gmail/callback on the app origin as the Google OAuth redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enables application summaries on Overview. /hub stays directly accessible.
# Enable only after applying the versioned migration and validating /hub.
NEXT_PUBLIC_JOB_HUB_ENABLED=false
# Enable only after configuring the protected scheduler and checking its logs.
OFFERFIT_BACKGROUND_SYNC_ENABLED=false
CRON_SECRET=
# Local sample-data preview only; ignored in production.
OFFERFIT_PREVIEW_ENABLED=false
